<Window x:Class="LiveWallpaper.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pet"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        ResizeMode="NoResize"
        Width="160" Height="200"
        Left="400" Top="400">

    <!-- Root canvas: bubble on top, pet at the bottom -->
    <Grid>
        <!-- Speech / thought bubble -->
        <Border x:Name="Bubble" Background="#F2FFFFFF" CornerRadius="12"
                BorderBrush="#33000000" BorderThickness="1"
                Padding="10,6" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,4,0,0" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.25"/>
            </Border.Effect>
            <TextBlock x:Name="BubbleText" Text="Hi!" FontSize="13" FontWeight="SemiBold"
                       Foreground="#222" TextAlignment="Center"/>
        </Border>

        <!-- The pet itself, drawn with vector shapes -->
        <Viewbox x:Name="PetBox" Width="120" Height="120"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <Viewbox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="Facing" CenterX="60" CenterY="60" ScaleX="1"/>
                    <ScaleTransform x:Name="Squash" CenterX="60" CenterY="110" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="Bob" Y="0"/>
                </TransformGroup>
            </Viewbox.RenderTransform>
            <Canvas Width="120" Height="120">
                <!-- Shadow -->
                <Ellipse x:Name="Shadow" Canvas.Left="28" Canvas.Top="104" Width="64" Height="14"
                         Fill="#33000000"/>

                <!-- Ears -->
                <Polygon Points="34,34 46,10 58,40" Fill="#4FD1C5"/>
                <Polygon Points="86,34 74,10 62,40" Fill="#4FD1C5"/>
                <Polygon Points="38,32 46,18 52,36" Fill="#F6AD9E"/>
                <Polygon Points="82,32 74,18 68,36" Fill="#F6AD9E"/>

                <!-- Body blob -->
                <Path x:Name="Body" Fill="#4FD1C5" Stroke="#3BB3A8" StrokeThickness="2"
                      Data="M60,28
                            C 30,28 22,52 22,74
                            C 22,98 40,110 60,110
                            C 80,110 98,98 98,74
                            C 98,52 90,28 60,28 Z"/>

                <!-- Cheeks -->
                <Ellipse Canvas.Left="34" Canvas.Top="74" Width="12" Height="8" Fill="#F6AD9E" Opacity="0.8"/>
                <Ellipse Canvas.Left="74" Canvas.Top="74" Width="12" Height="8" Fill="#F6AD9E" Opacity="0.8"/>

                <!-- Eyes -->
                <Ellipse x:Name="LeftEye" Canvas.Left="42" Canvas.Top="56" Width="14" Height="16" Fill="White"/>
                <Ellipse x:Name="RightEye" Canvas.Left="64" Canvas.Top="56" Width="14" Height="16" Fill="White"/>
                <Ellipse x:Name="LeftPupil" Canvas.Left="46" Canvas.Top="61" Width="7" Height="8" Fill="#222"/>
                <Ellipse x:Name="RightPupil" Canvas.Left="68" Canvas.Top="61" Width="7" Height="8" Fill="#222"/>

                <!-- Mouth -->
                <Path x:Name="Mouth" Stroke="#333" StrokeThickness="2" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" Data="M54,84 Q60,90 66,84"/>
            </Canvas>
        </Viewbox>
    </Grid>
</Window>
